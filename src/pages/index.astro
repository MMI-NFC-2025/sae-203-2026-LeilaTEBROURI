---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/hero.astro";
import iconCalendar from "../assets/Icone_calendrier.svg";
import iconLocation from "../assets/Icone_position.svg";
import iconTicket from "../assets/Icone_billeterie.svg";
import imageVinyl from "../assets/imagevinyl.avif";
import imgProgramme from "../assets/img_programme.jpg";
import imgArtiste from "../assets/img_artiste.jpg";
import imgInfosPratiques from "../assets/infos_pratiques .jpg";
import {
	homepagePartenaires,
	partenaireLogoUrl,
} from "../../backend/backend.mjs";

type PartenaireRecord = {
	id: string;
	nom: string;
	lien?: string;
	logo?: string;
};

const partenaires = (await homepagePartenaires()) as PartenaireRecord[];

const getPartenaireLogoUrl = partenaireLogoUrl;
---

<Layout>
	<Header />
	<main class="min-h-[40vh] bg-(--blue) pb-8">
		<Hero />
		<section class="space-y-6 px-2 py-6 mt-20">
			<div
				class="flex items-center gap-5 rounded-4xl bg-gray-100 px-6 py-7 shadow-md"
			>
				<img
					src={iconCalendar.src}
					alt="Calendrier"
					class="h-10 w-10"
					loading="lazy"
				/>
				<p class="pl-5 text-2xl leading-none">Du 28 au 30 Août 2026</p>
			</div>

			<div
				class="flex items-center gap-5 rounded-4xl bg-gray-100 px-6 py-7 shadow-md"
			>
				<img
					src={iconLocation.src}
					alt="Localisation"
					class="h-10 w-10"
					loading="lazy"
				/>
				<p class="pl-5 text-2xl leading-tight">
					Parc du Près-la-Rose, Montbéliard
				</p>
			</div>

			<a
				href="/billetterie"
				class="flex items-center gap-5 rounded-4xl bg-(--yellow) px-6 py-7 shadow-md"
			>
				<img
					src={iconTicket.src}
					alt="Billetterie"
					class="h-10 w-10"
					loading="lazy"
				/>
				<p class="pl-5 text-2xl leading-none">Billetterie</p>
			</a>
		</section>

		<section class="mt-6 bg-(--red) px-6 py-8">
			<h2 class="text-6xl uppercase leading-none">
				Musique<br />
				Régionale
			</h2>
			<div class="mt-8 h-2 w-40 bg-black rounded-4xl"></div>
			<h3 class="mt-12 text-6xl uppercase leading-none">Folk</h3>
		</section>

		<img
			src={imageVinyl.src}
			alt="Image vinyle"
			class="mt-20 block h-auto w-30"
			loading="lazy"
		/>

		<section class="mt-40">
			<a href="/programmation" class="block">
				<img
					src={imgProgramme.src}
					alt="Programme"
					class="block h-80 w-full object-cover"
					loading="lazy"
				/>
				<div
					class="bg-(--yellow) py-6 text-center text-black rounded-4xl ml-20 mr-20 mt-10"
				>
					<h3 class="leading-none">Programme</h3>
				</div>
			</a>

			<a href="/artistes" class="block mt-30">
				<img
					src={imgArtiste.src}
					alt="Invités"
					class="block h-80 w-full object-cover"
					loading="lazy"
				/>
				<div
					class="bg-(--yellow) py-6 text-center text-black rounded-4xl ml-20 mr-20 mt-10"
				>
					<h3 class="leading-none">Invités</h3>
				</div>
			</a>

			<a href="/infos-pratiques" class="block mt-30">
				<img
					src={imgInfosPratiques.src}
					alt="Infos pratiques"
					class="block h-80 w-full object-cover"
					loading="lazy"
				/>
				<div
					class="bg-(--yellow) py-6 text-center text-black rounded-4xl ml-20 mr-20 mt-10"
				>
					<h3 class="leading-none">Infos pratiques</h3>
				</div>
			</a>
		</section>

		<section class="mt-20 bg-(--red)">
			<div class="py-8 text-center">
				<h2 class="text-4xl leading-none">Partenaires</h2>
			</div>

			<div class="grid grid-cols-2 items-center gap-8 px-6 py-16">
				{
					partenaires.length > 0 ? (
						partenaires.map((partenaire) => (
							<a
								href={partenaire.lien || "#"}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center justify-center"
							>
								{getPartenaireLogoUrl(partenaire) && (
									<img
										src={getPartenaireLogoUrl(partenaire)}
										alt={partenaire.nom}
										class="block w-full max-w-xs object-contain"
										loading="lazy"
									/>
								)}
							</a>
						))
					) : (
						<p class="text-center text-2xl text-gray-100">
							Aucun partenaire disponible pour le moment.
						</p>
					)
				}
			</div>
		</section>
	</main>
	<Footer />
</Layout>
