---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PbImage from "../../components/PbImage.astro";
import {
    allArtistesByDate,
    allScenesByName,
} from "../../../backend/backend.mjs";

const artistes = await allArtistesByDate();
const scenes = await allScenesByName();

const genres = Array.from(
    new Set(
        artistes
            .map((artiste) => String(artiste.genre ?? "").trim())
            .filter((genre) => genre.length > 0),
    ),
).sort((firstGenre, secondGenre) =>
    firstGenre.localeCompare(secondGenre, "fr"),
);

let selectedGenre = "";
let selectedScene = "";
let selectedHeureMin = "";
let selectedHeureMax = "";
let message = "";

let filteredArtistes = artistes;

type ProgrammationItem = {
    id: string;
    nom: string;
    heure: string;
    scene: string;
    record: {
        id: string;
        collectionName: string;
        img: string;
    };
};

type ProgrammationGroup = {
    label: string;
    items: ProgrammationItem[];
};

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();

    selectedGenre = String(data.get("genre") ?? "").trim();
    selectedScene = String(data.get("scene") ?? "").trim();
    selectedHeureMin = String(data.get("heureMin") ?? "").trim();
    selectedHeureMax = String(data.get("heureMax") ?? "").trim();

    if (
        selectedHeureMin &&
        selectedHeureMax &&
        selectedHeureMax < selectedHeureMin
    ) {
        message = "Veuillez entrer une plage horaire valide.";
        filteredArtistes = [];
    } else {
        filteredArtistes = artistes.filter((artiste) => {
            const genre = String(artiste.genre ?? "").trim();
            const scene = String(artiste.expand?.scene?.nom ?? "").trim();
            const heure = String(artiste.date_performance ?? "").slice(11, 16);

            if (selectedGenre && genre !== selectedGenre) {
                return false;
            }

            if (selectedScene && scene !== selectedScene) {
                return false;
            }

            if (selectedHeureMin && heure < selectedHeureMin) {
                return false;
            }

            if (selectedHeureMax && heure > selectedHeureMax) {
                return false;
            }

            return true;
        });

        if (filteredArtistes.length === 0) {
            message = "Aucun artiste ne correspond à ces filtres.";
        } else {
            message = `${filteredArtistes.length} artiste(s) correspondent aux filtres.`;
        }
    }
}

const groupedProgrammation = filteredArtistes.reduce<
    Record<string, ProgrammationGroup>
>((groups, artiste) => {
    const rawDateTime = String(artiste.date_performance ?? "");
    const dateKey = rawDateTime.slice(0, 10);
    const heure = rawDateTime.slice(11, 16);

    if (!dateKey) {
        return groups;
    }

    if (!groups[dateKey]) {
        const formattedDate = new Date(
            `${dateKey}T00:00:00Z`,
        ).toLocaleDateString("fr-FR", {
            weekday: "long",
            day: "2-digit",
            month: "long",
            year: "numeric",
            timeZone: "UTC",
        });

        groups[dateKey] = {
            label: formattedDate,
            items: [],
        };
    }

    groups[dateKey].items.push({
        id: String(artiste.id ?? ""),
        nom: String(artiste.nom ?? "Artiste"),
        heure,
        scene: String(artiste.expand?.scene?.nom ?? ""),
        record: {
            id: String(artiste.id ?? ""),
            collectionName: "artiste",
            img: artiste.img ? String(artiste.img) : "",
        },
    });

    return groups;
}, {});

const programmation = Object.values(groupedProgrammation);
---

<Layout>
    <Header />
    <main class="min-h-screen bg-(--blue) px-6 py-10 lg:pb-16">
        <div
            class="mx-auto w-fit bg-(--red) px-8 py-5 text-center text-black mb-10"
        >
            <h2 class="leading-none">Programme</h2>
        </div>

        <section class="mb-10 lg:mx-auto lg:w-full lg:max-w-330">
            <form
                action="/programmation"
                method="POST"
                class="space-y-4 bg-(--navyblue) p-5 text-(--light) lg:grid lg:grid-cols-4 lg:gap-4 lg:space-y-0"
            >
                <label class="block">
                    <span class="mb-2 block">Genre</span>
                    <select
                        name="genre"
                        class="w-full bg-(--light) px-4 py-3 text-(--dark)"
                    >
                        <option value="">Tous les genres</option>
                        {
                            genres.map((genre) => (
                                <option
                                    value={genre}
                                    selected={selectedGenre === genre}
                                >
                                    {genre}
                                </option>
                            ))
                        }
                    </select>
                </label>

                <label class="block">
                    <span class="mb-2 block">Scène</span>
                    <select
                        name="scene"
                        class="w-full bg-(--light) px-4 py-3 text-(--dark)"
                    >
                        <option value="">Toutes les scènes</option>
                        {
                            scenes.map((scene) => (
                                <option
                                    value={scene.nom}
                                    selected={selectedScene === scene.nom}
                                >
                                    {scene.nom}
                                </option>
                            ))
                        }
                    </select>
                </label>

                <label class="block">
                    <span class="mb-2 block">Heure min</span>
                    <input
                        type="time"
                        name="heureMin"
                        value={selectedHeureMin}
                        class="w-full bg-(--light) px-4 py-3 text-(--dark)"
                    />
                </label>

                <label class="block">
                    <span class="mb-2 block">Heure max</span>
                    <input
                        type="time"
                        name="heureMax"
                        value={selectedHeureMax}
                        class="w-full bg-(--light) px-4 py-3 text-(--dark)"
                    />
                </label>

                <div class="flex gap-3 lg:col-span-4">
                    <button
                        type="submit"
                        class="bg-(--yellow) px-6 py-3 text-(--dark)"
                    >
                        Filtrer
                    </button>
                    <a
                        href="/programmation"
                        class="bg-(--light) px-6 py-3 text-(--dark)"
                    >
                        Réinitialiser
                    </a>
                </div>
            </form>

            {message && <p class="mt-4 text-(--light)">{message}</p>}
        </section>

        <section class="space-y-8 lg:mx-auto lg:w-full lg:max-w-330">
            {
                programmation.length > 0 ? (
                    programmation.map((jour) => (
                        <article class="space-y-4">
                            <h3 class="text-(--light) text-3xl capitalize lg:text-center mb-10 mt-20">
                                {jour.label}
                            </h3>

                            <div class="space-y-3 lg:flex lg:flex-wrap lg:justify-center lg:gap-4 lg:space-y-0">
                                {jour.items.map((artiste) => (
                                    <a
                                        href={`/programmation/${artiste.id}`}
                                        class="block bg-(--yellow) p-4 text-(--dark) lg:w-full lg:max-w-sm"
                                    >
                                        <PbImage
                                            record={artiste.record}
                                            field="img"
                                            alt={artiste.nom}
                                            classImg="mb-3 h-40 w-full object-cover lg:h-56 lg:object-contain"
                                            size="400x400"
                                        />
                                        <p class="text-xl leading-tight">
                                            {artiste.heure} — {artiste.nom}
                                        </p>
                                        {artiste.scene && (
                                            <p class="mt-1 text-base leading-tight">
                                                {artiste.scene}
                                            </p>
                                        )}
                                    </a>
                                ))}
                            </div>
                        </article>
                    ))
                ) : (
                    <p class="text-(--light) text-xl">
                        Aucune programmation disponible.
                    </p>
                )
            }
        </section>
        <div
            class="mx-auto w-fit bg-(--red) px-8 py-5 text-center text-black mb-10 mt-20"
        >
            <h2 class="leading-none">Télécharger le programme</h2>
        </div>
    </main>
    <Footer />
</Layout>
