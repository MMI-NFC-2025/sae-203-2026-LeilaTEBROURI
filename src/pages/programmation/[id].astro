---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PbImage from "../../components/PbImage.astro";
import imageIllustrationGraphique from "../../assets/imageillustrationgraphique.avif";
import {
    homepageArtisteById,
    homepageArtistesCarousel,
} from "../../../backend/backend.mjs";

const { id } = Astro.params;
const artiste = await homepageArtisteById(id);
const artistesCarousel = (await homepageArtistesCarousel()).filter(
    (item) => item.id !== id,
);
const artisteImages = Array.isArray(artiste?.imageUrls)
    ? artiste.imageUrls.slice(0, 3)
    : [];
---

<Layout>
    <Header />
    <main class="min-h-screen bg-(--blue) px-6 py-10 lg:pb-16">
        {
            artiste ? (
                <section class="space-y-6 lg:mx-auto lg:w-full lg:max-w-330">
                    <div class="mx-auto w-fit bg-(--red) px-8 py-5 text-center text-black">
                        <h2 class="leading-none">{artiste.nom}</h2>
                    </div>

                    {artisteImages.length > 0 ? (
                        <div class="relative">
                            <button
                                id="artiste-images-prev"
                                type="button"
                                class="absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-(--navyblue) text-(--light) transition hover:bg-(--red) hover:text-black"
                                aria-label="Image précédente"
                            >
                                <span
                                    aria-hidden="true"
                                    class="text-2xl leading-none"
                                >
                                    ‹
                                </span>
                            </button>

                            <div
                                id="artiste-images-carousel"
                                class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2"
                                aria-label="Carousel images artiste"
                            >
                                {artisteImages.map((imageUrl) => (
                                    <div class="w-full shrink-0 snap-start">
                                        <img
                                            src={imageUrl}
                                            alt={artiste.nom}
                                            class="block h-auto w-full object-cover lg:max-h-160"
                                            loading="lazy"
                                        />
                                    </div>
                                ))}
                            </div>

                            <button
                                id="artiste-images-next"
                                type="button"
                                class="absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-(--navyblue) text-(--light) transition hover:bg-(--red) hover:text-black"
                                aria-label="Image suivante"
                            >
                                <span
                                    aria-hidden="true"
                                    class="text-2xl leading-none"
                                >
                                    ›
                                </span>
                            </button>
                        </div>
                    ) : (
                        <PbImage
                            record={artiste.record}
                            field="img"
                            alt={artiste.nom}
                            classImg="block h-auto w-full object-cover lg:max-h-160"
                            size="1200x0"
                        />
                    )}

                    <div class="bg-(--yellow) p-5 text-(--dark) lg:p-8">
                        <p class="text-xl leading-tight">
                            {artiste.date} — {artiste.heure}
                        </p>
                        {artiste.scene && (
                            <p class="mt-2 text-base leading-tight">
                                Scène : {artiste.scene}
                            </p>
                        )}
                        {artiste.genre && (
                            <p class="mt-2 text-base leading-tight">
                                Genre : {artiste.genre}
                            </p>
                        )}
                    </div>

                    <img
                        src={imageIllustrationGraphique.src}
                        alt="Illustration graphique"
                        class="block h-auto w-full lg:max-h-96 lg:object-cover"
                        loading="lazy"
                    />

                    {artiste.description && (
                        <div class="bg-(--navyblue) p-6 text-(--light)">
                            <p class="leading-tight">{artiste.description}</p>
                        </div>
                    )}

                    {artistesCarousel.length > 0 && (
                        <section class="space-y-4">
                            <div class="mx-auto w-fit bg-(--red) px-6 py-3 text-center text-black">
                                <h3 class="leading-none">Autres artistes</h3>
                            </div>

                            <div class="flex gap-4 overflow-x-auto pb-2">
                                {artistesCarousel.map((item) => (
                                    <a
                                        href={`/programmation/${item.id}`}
                                        class="min-w-64 bg-(--yellow) p-3 text-(--dark) lg:min-w-80"
                                    >
                                        <PbImage
                                            record={item.record}
                                            field="img"
                                            alt={item.nom}
                                            classImg="h-44 w-full object-cover"
                                            size="600x600"
                                        />
                                        <p class="mt-3 text-xl leading-tight">
                                            {item.nom}
                                        </p>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}
                </section>
            ) : (
                <p class="text-(--light) text-xl">Artiste introuvable.</p>
            )
        }
    </main>
    <Footer />
</Layout>

<script is:inline>
    const carousel = document.getElementById("artiste-images-carousel");
    const prevButton = document.getElementById("artiste-images-prev");
    const nextButton = document.getElementById("artiste-images-next");

    if (carousel && prevButton && nextButton) {
        prevButton.addEventListener("click", () => {
            carousel.scrollBy({
                left: -carousel.clientWidth,
                behavior: "smooth",
            });
        });

        nextButton.addEventListener("click", () => {
            carousel.scrollBy({
                left: carousel.clientWidth,
                behavior: "smooth",
            });
        });
    }
</script>
