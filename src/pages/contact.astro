---
import Layout from "../layouts/Layout.astro";
import { addContactMessage } from "../../backend/backend.mjs";

let successMessage = "";
let errorMessage = "";

let nom = "";
let email = "";
let sujet = "";
let message = "";

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();

    const botField = String(data.get("bot-field") ?? "").trim();
    nom = String(data.get("nom") ?? "").trim();
    email = String(data.get("email") ?? "").trim();
    sujet = String(data.get("sujet") ?? "").trim();
    message = String(data.get("message") ?? "").trim();
    const consentement = data.get("consentement") === "on";

    if (botField) {
        successMessage = "Message envoyé.";
    } else if (!nom || !email || !sujet || !message || !consentement) {
        errorMessage =
            "Merci de remplir tous les champs et d’accepter le consentement.";
    } else {
        try {
            await addContactMessage({
                Nom: nom,
                Mail: email,
                Sujet: sujet,
                Message: message,
                Consentement: consentement,
            });

            successMessage = "Merci, votre message a bien été envoyé.";
            nom = "";
            email = "";
            sujet = "";
            message = "";
        } catch (error) {
            const messageText =
                error instanceof Error ? error.message : String(error ?? "");

            if (
                messageText.includes("Only superusers can perform this action")
            ) {
                errorMessage =
                    "Configuration PocketBase: autorise la règle Create de la collection contact.";
            } else {
                errorMessage =
                    "Impossible d’envoyer le message pour le moment.";
            }
        }
    }
}
---

<Layout>
    <main class="min-h-screen bg-(--blue) px-6 py-10 lg:pb-16">
        <div
            class="mx-auto mb-10 w-fit bg-(--red) px-8 py-5 text-center text-black"
        >
            <h2 class="leading-none">Contact</h2>
        </div>

        <section
            class="mx-auto bg-(--red) p-6 md:p-8 lg:w-full lg:max-w-330 lg:p-10"
        >
            <p class="mb-8 text-black lg:text-xl">
                Une question sur le festival ?
            </p>
            <p class="mb-10 lg:text-lg">Envoie-nous ton message.</p>

            <form
                name="contact"
                method="POST"
                action="/contact"
                class="space-y-9"
            >
                <p class="hidden">
                    <label>
                        Ne pas remplir ce champ :
                        <input name="bot-field" />
                    </label>
                </p>

                <div
                    class="space-y-9 lg:grid lg:grid-cols-(--my-grid) lg:gap-8 lg:space-y-0"
                >
                    <label class="block lg:col-span-6">
                        <span class="mb-4 block leading-none text-black"
                            >Nom</span
                        >
                        <input
                            type="text"
                            name="nom"
                            value={nom}
                            required
                            placeholder="Indiquer votre demande"
                            class="w-full bg-gray-100 px-8 py-6 text-black placeholder:text-gray-700/90 focus:outline-none"
                        />
                    </label>

                    <label class="block lg:col-span-6">
                        <span class="mb-4 block leading-none text-black"
                            >Mail</span
                        >
                        <input
                            type="email"
                            name="email"
                            value={email}
                            required
                            placeholder="Indiquer votre mail"
                            class="w-full bg-gray-100 px-8 py-6 text-black placeholder:text-gray-700/90 focus:outline-none"
                        />
                    </label>

                    <label class="block lg:col-span-6">
                        <span class="mb-4 block leading-none text-black"
                            >Sujet</span
                        >
                        <input
                            type="text"
                            name="sujet"
                            value={sujet}
                            required
                            placeholder="Décrivez votre sujet"
                            class="w-full bg-gray-100 px-8 py-6 text-black placeholder:text-gray-700/90 focus:outline-none"
                        />
                    </label>
                </div>

                <label class="block">
                    <span class="mb-4 block leading-none text-black"
                        >Message</span
                    >
                    <textarea
                        name="message"
                        required
                        rows="8"
                        placeholder="..."
                        class="w-full bg-gray-100 px-8 py-6 text-black placeholder:text-gray-700/90 focus:outline-none"
                        >{message}</textarea
                    >
                </label>

                <label class="flex items-start gap-3 text-black">
                    <input
                        type="checkbox"
                        name="consentement"
                        required
                        class="mt-1 h-5 w-5"
                    />
                    <span>
                        J’accepte que mes données soient utilisées uniquement
                        pour répondre à ma demande. *
                    </span>
                </label>

                <button
                    type="submit"
                    class="bg-(--yellow) px-10 py-4 text-black lg:text-lg"
                >
                    Envoyer le message
                </button>

                {
                    successMessage && (
                        <p class="bg-(--yellow) px-6 py-4 text-(--dark)">
                            {successMessage}
                        </p>
                    )
                }

                {
                    errorMessage && (
                        <p class="bg-(--red) px-6 py-4 text-black">
                            {errorMessage}
                        </p>
                    )
                }
            </form>

            <div class="mt-12 border-t border-black/20 pt-10 text-black">
                <div
                    class="space-y-8 lg:grid lg:grid-cols-(--my-grid) lg:gap-8 lg:space-y-0"
                >
                    <section class="space-y-3 lg:col-span-6">
                        <h3 class="leading-none">Coordonnées</h3>
                        <p class="text-base leading-tight">
                            Email :
                            <a
                                href="mailto:contact@jumelages-festival.fr"
                                class="underline"
                            >
                                contact@jumelages-festival.fr
                            </a>
                        </p>
                        <p class="text-base leading-tight">
                            Téléphone :
                            <a href="tel:+33381000000" class="underline">
                                03 81 00 00 00
                            </a>
                        </p>
                        <p class="text-base leading-tight">
                            Adresse : 4 Place de l'Europe, 25200 Montbéliard
                        </p>
                    </section>

                    <section class="space-y-3 lg:col-span-6">
                        <h3 class="leading-none">Réseaux sociaux</h3>
                        <div class="flex items-center gap-3">
                            <a
                                href="https://www.instagram.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Instagram"
                                class="rounded-full border border-black p-2"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    class="h-5 w-5"
                                    aria-hidden="true"
                                >
                                    <rect
                                        x="3"
                                        y="3"
                                        width="18"
                                        height="18"
                                        rx="5"></rect>
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <circle cx="17.5" cy="6.5" r="1"></circle>
                                </svg>
                            </a>

                            <a
                                href="https://www.facebook.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Facebook"
                                class="rounded-full border border-black p-2"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    class="h-5 w-5"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                                    ></path>
                                </svg>
                            </a>

                            <a
                                href="https://www.youtube.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="YouTube"
                                class="rounded-full border border-black p-2"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    class="h-5 w-5"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.94 1.96C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"
                                    ></path>
                                    <polygon
                                        points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"
                                    ></polygon>
                                </svg>
                            </a>
                        </div>
                    </section>
                </div>
            </div>
        </section>
    </main>
</Layout>
