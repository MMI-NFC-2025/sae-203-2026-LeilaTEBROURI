---
import mmiLogo from "../assets/logo_mmi.webp";
---

<footer class="bg-amber-300 px-4 py-8 text-black lg:px-10 lg:py-12">
    <div class="grille space-y-8 lg:space-y-0">
        <div class="space-y-10 lg:col-span-7">
            <div class="space-y-1">
                <h2 class="text-5xl uppercase">
                    Jumelages<br />
                </h2>
                <h3 class="m-0 uppercase">Festival</h3>
            </div>

            <section class="space-y-3 text-base">
                <h3 class="uppercase">Contact</h3>
                <p class="text-sm leading-tight">
                    Virgile Esnaux<br />
                    MMi1 B2<br />
                    <p class="text-sm">virgile.esnaux@edu.univ-fcomte.fr</p>
                </p>
                <p class="text-sm">03.00.00.00.00</p>
            </section>

            <section class="space-y-3">
                <h3 class="uppercase">Mentions légales</h3>
                <p class="text-xs leading-tight">
                    “projet de festival réalisé en 2025 dans le cadre d’un
                    exercice pédagogique au département MMI de Montbéliard“
                </p>
            </section>
        </div>

        <div
            class="mt-33 flex flex-col items-start gap-6 lg:col-span-5 lg:mt-0 lg:pt-10"
        >
            <nav aria-label="Navigation footer">
                <ul class="space-y-2 text-base leading-snug">
                    <li><a href="/a-propos">À propos</a></li>
                    <li><a href="/programmation">Programmation</a></li>
                    <li><a href="/artistes">Artistes</a></li>
                    <li><a href="/scene">Scène</a></li>
                    <li><a href="/infos-pratiques">Infos pratiques</a></li>
                    <li><a href="/contact">Contact</a></li>
                </ul>
            </nav>

            <section class="space-y-2" aria-label="Réseaux sociaux">
                <h3 class="uppercase">Réseaux sociaux</h3>
                <div class="flex items-center gap-3">
                    <a
                        href="https://www.instagram.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="rounded-full border border-black p-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="h-5 w-5"
                            aria-hidden="true"
                        >
                            <rect x="3" y="3" width="18" height="18" rx="5"
                            ></rect>
                            <circle cx="12" cy="12" r="4"></circle>
                            <circle cx="17.5" cy="6.5" r="1"></circle>
                        </svg>
                    </a>
                    <a
                        href="https://www.facebook.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook"
                        class="rounded-full border border-black p-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="h-5 w-5"
                            aria-hidden="true"
                        >
                            <path
                                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href="https://www.youtube.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube"
                        class="rounded-full border border-black p-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="h-5 w-5"
                            aria-hidden="true"
                        >
                            <path
                                d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.94 1.96C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"
                            ></path>
                            <polygon
                                points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"
                            ></polygon>
                        </svg>
                    </a>
                </div>
            </section>

            <div class="h-1 w-full bg-black rounded-4xl"></div>

            <div class="w-full max-w-xs rounded-4xl p-5">
                <img
                    src={mmiLogo.src}
                    alt="Logo MMI"
                    class="h-auto w-full"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</footer>
