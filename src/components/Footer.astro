---
import mmiLogo from "../assets/logo_mmi.webp";
---

<footer class="bg-amber-300 px-4 py-8 text-black">
    <div class="mx-auto grid max-w-xl grid-cols-2 gap-8">
        <div class="space-y-10">
            <div class="space-y-1">
                <h2 class="text-5xl uppercase">
                    Jumelages<br />
                </h2>
                <h3 class="m-0 uppercase">Festival</h3>
            </div>

            <section class="space-y-3 text-base">
                <h3 class="uppercase">Contact</h3>
                <p class="leading-tight text-xs">
                    Virgile Esnaux<br />
                    MMi1 B2<br />
                    virgile.esnaux@edu.univ-fcomte.fr
                </p>
            </section>

            <section class="space-y-3">
                <h3 class="uppercase">Mentions légales</h3>
                <p class="text-xs leading-tight">
                    “projet de festival réalisé en 2025 dans le cadre d’un
                    exercice pédagogique au département MMI de Montbéliard“
                </p>
            </section>
        </div>

        <div class="mt-33 flex flex-col items-start gap-6">
            <nav aria-label="Navigation footer">
                <ul class="space-y-2 text-base leading-snug">
                    <li><a href="/festival">Festival</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/a-propos">À propos</a></li>
                    <li><a href="/infos-pratiques">Infos pratiques</a></li>
                </ul>
            </nav>

            <div class="h-1 w-full bg-black rounded-4xl"></div>

            <div class="w-full max-w-xs rounded-4xl p-5">
                <img
                    src={mmiLogo.src}
                    alt="Logo MMI"
                    class="h-auto w-full"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</footer>
