---
import mmiLogo from "../assets/logo_mmi.webp";

const footerLinks = [
    { href: "/a-propos", label: "À propos" },
    { href: "/programmation", label: "Programmation" },
    { href: "/artistes", label: "Artistes" },
    { href: "/scene", label: "Scène" },
    { href: "/infos-pratiques", label: "Infos pratiques" },
    { href: "/contact", label: "Contact" },
];
---

<footer
    class="overflow-x-hidden bg-amber-300 px-4 py-8 text-black lg:px-10 lg:py-12"
>
    <div
        class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)_9rem] gap-4 sm:grid-cols-[1fr_auto] sm:gap-8 lg:gap-12"
    >
        <div class="min-w-0 space-y-10">
            <div class="space-y-3">
                <h2 class="text-4xl uppercase lg:text-5xl">Jumelages</h2>
                <h3 class="text-3xl">Festival</h3>
            </div>

            <section class="space-y-3 text-base">
                <h3 class="uppercase">Contact</h3>
                <div class="space-y-1 text-sm leading-tight">
                    <p>Virgile Esnaux</p>
                    <p>MMi1 B2</p>
                    <p>virgile.esnaux@</p>
                    <p>edu.univ-fcomte.fr</p>
                    <p>03.00.00.00.00</p>
                </div>
            </section>

            <section class="space-y-3">
                <h3 class="uppercase">Mentions légales</h3>
                <p class="max-w-xs text-xs leading-tight">
                    “projet de festival réalisé en 2025 dans le cadre d’un
                    exercice pédagogique au département MMI de Montbéliard“
                </p>
            </section>
        </div>

        <div
            class="flex w-36 min-w-0 flex-col items-start gap-6 mt-35 sm:w-auto lg:items-start lg:pt-10"
        >
            <nav aria-label="Navigation footer">
                <ul class="space-y-2 text-base leading-snug">
                    {
                        footerLinks.map((link) => (
                            <li>
                                <a href={link.href}>{link.label}</a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <section class="w-full space-y-2" aria-label="Réseaux sociaux">
                <h3 class="uppercase">Réseaux sociaux</h3>
                <div class="flex items-center gap-3">
                    <a
                        href="https://www.instagram.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="rounded-full border border-black p-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="h-5 w-5"
                            aria-hidden="true"
                        >
                            <rect x="3" y="3" width="18" height="18" rx="5"
                            ></rect>
                            <circle cx="12" cy="12" r="4"></circle>
                            <circle cx="17.5" cy="6.5" r="1"></circle>
                        </svg>
                    </a>
                    <a
                        href="https://www.facebook.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook"
                        class="rounded-full border border-black p-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="h-5 w-5"
                            aria-hidden="true"
                        >
                            <path
                                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href="https://www.youtube.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube"
                        class="rounded-full border border-black p-2"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="h-5 w-5"
                            aria-hidden="true"
                        >
                            <path
                                d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.94 1.96C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"
                            ></path>
                            <polygon
                                points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"
                            ></polygon>
                        </svg>
                    </a>
                </div>
            </section>

            <div class="h-1 w-full rounded-4xl bg-black lg:w-72"></div>

            <div
                class="w-full max-w-36 rounded-4xl p-0 sm:max-w-44 lg:max-w-xs lg:p-5"
            >
                <img
                    src={mmiLogo.src}
                    alt="Logo MMI"
                    class="h-auto w-full"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</footer>
