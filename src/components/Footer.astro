---
import mmiLogo from "../assets/logo_mmi.webp";
---

<footer class="bg-amber-300 px-4 py-8 text-black md:px-8 md:py-10">
    <div class="mx-auto grid max-w-7xl grid-cols-[1fr_auto] gap-8 md:gap-12">
        <div class="space-y-10">
            <h2 class="text-4xl uppercase">
                Jumelages<br />
                Festival
            </h2>

            <section class="space-y-3 text-base">
                <h3 class="font-bold uppercase">Contact</h3>
                <p class="leading-tight">
                    Virgile Esnaux<br />
                    MMi1 B2<br />
                    virgile.esnaux@edu.univ-fcomte.fr
                </p>
            </section>

            <section class="space-y-3">
                <h3 class="font-bold uppercase">Mentions légales</h3>
                <p class="text-sm leading-tight">
                    “projet de festival réalisé en 2025 dans le cadre d’un
                    exercice pédagogique au département MMI de Montbéliard“
                </p>
            </section>
        </div>

        <div class="flex flex-col items-start gap-6 md:items-end">
            <nav aria-label="Navigation footer">
                <ul class="space-y-2 text-base leading-snug md:text-right">
                    <li><a href="/festival">Festival</a></li>
                    <li><a href="/contact">Contactez-nous</a></li>
                    <li><a href="/a-propos">À propos</a></li>
                    <li><a href="/infos-pratiques">Infos pratiques</a></li>
                </ul>
            </nav>

            <div class="h-1 w-full bg-black md:w-72"></div>

            <div class="w-full max-w-xs rounded-4xl p-5 md:w-72">
                <img
                    src={mmiLogo.src}
                    alt="Logo MMI"
                    class="h-auto w-full"
                    loading="lazy"
                />
            </div>
        </div>
    </div>
</footer>
