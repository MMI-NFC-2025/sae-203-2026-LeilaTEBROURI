---
const links = [
    { label: "À Propos", href: "/a-propos" },
    { label: "Programmation", href: "/programmation" },
    { label: "Artistes", href: "/artistes" },
    { label: "Scène", href: "/scene" },
    { label: "Infos pratiques", href: "/infos-pratiques" },
    { label: "Contact", href: "/contact" },
];

const moreLinks = [
    { label: "Inscription", href: "/inscription" },
    { label: "Connexion", href: "/connexion" },
    { label: "Gestion", href: "/gestion" },
];

const mobileLinks = [...links, ...moreLinks];
---

<header
    class="sticky top-0 z-10 bg-amber-300 px-4 py-5 lg:px-8 lg:py-5 xl:px-10"
>
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6">
        <a
            href="/"
            aria-label="Accueil"
            class="shrink-0 text-4xl font-black uppercase tracking-tight text-black font-important lg:text-5xl"
        >
            Jumelages
        </a>

        <nav class="hidden lg:block" aria-label="Navigation principale">
            <ul class="flex items-center justify-end gap-2 text-black">
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="block whitespace-nowrap rounded-md bg-gray-100 px-4 py-2 text-xl leading-none transition hover:bg-black hover:text-gray-100"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }

                <li class="relative">
                    <button
                        id="desktop-more-btn"
                        type="button"
                        aria-expanded="false"
                        aria-controls="desktop-more-menu"
                        class="flex items-center gap-2 rounded-md bg-gray-100 px-4 py-2 text-xl leading-none transition hover:bg-black hover:text-gray-100"
                    >
                        Plus
                        <span aria-hidden="true">▾</span>
                    </button>

                    <div
                        id="desktop-more-menu"
                        class="invisible absolute right-0 top-full z-40 mt-2 w-56 rounded-md bg-gray-100 p-2 opacity-0 shadow-md transition"
                    >
                        {
                            moreLinks.map((link) => (
                                <a
                                    href={link.href}
                                    class="block rounded px-3 py-2 text-lg text-black transition hover:bg-black hover:text-gray-100"
                                >
                                    {link.label}
                                </a>
                            ))
                        }
                    </div>
                </li>
            </ul>
        </nav>

        <button
            id="menu-btn"
            type="button"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="relative z-30 flex h-10 w-10 flex-col items-center justify-center gap-1.5 lg:hidden"
        >
            <span class="block h-1 w-9 bg-black transition-all duration-300"
            ></span>
            <span class="block h-1 w-9 bg-black transition-all duration-300"
            ></span>
            <span class="block h-1 w-9 bg-black transition-all duration-300"
            ></span>
        </button>
    </div>

    <div
        id="mobile-overlay"
        class="invisible fixed inset-0 z-20 bg-black/20 opacity-0 transition-all duration-300 lg:hidden"
    >
    </div>

    <nav
        id="mobile-menu"
        aria-hidden="true"
        class="invisible fixed left-0 top-0 z-30 h-screen w-3/4 max-w-80 -translate-x-full overflow-y-auto overscroll-contain bg-amber-300 px-5 py-6 opacity-0 transition-all duration-300 lg:hidden"
    >
        <div class="mb-10 flex items-center justify-between">
            <a
                href="/"
                aria-label="Accueil"
                class="text-2xl font-black uppercase tracking-tight text-black font-important"
                >Jumelages</a
            >
            <button
                id="menu-close"
                type="button"
                aria-label="Fermer le menu"
                class="text-4xl leading-none text-black">×</button
            >
        </div>

        <ul class="space-y-4">
            {
                mobileLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="block bg-gray-100 px-3 py-3 text-center text-2xl font-medium text-black"
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<script>
    const menuBtn = document.querySelector("#menu-btn");
    const menuClose = document.querySelector("#menu-close");
    const menu = document.querySelector("#mobile-menu");
    const overlay = document.querySelector("#mobile-overlay");
    const desktopMoreButton = document.querySelector("#desktop-more-btn");
    const desktopMoreMenu = document.querySelector("#desktop-more-menu");

    function openMenu() {
        if (!menuBtn || !menu || !overlay) return;

        menuBtn.setAttribute("aria-expanded", "true");
        menu.setAttribute("aria-hidden", "false");

        menu.classList.remove("invisible", "opacity-0", "-translate-x-full");
        overlay.classList.remove("invisible", "opacity-0");

        document.body.classList.add("overflow-hidden");
    }

    function closeMenu() {
        if (!menuBtn || !menu || !overlay) return;

        menuBtn.setAttribute("aria-expanded", "false");
        menu.setAttribute("aria-hidden", "true");

        menu.classList.add("invisible", "opacity-0", "-translate-x-full");
        overlay.classList.add("invisible", "opacity-0");

        document.body.classList.remove("overflow-hidden");
    }

    if (menuBtn && menu && overlay) {
        menuBtn.addEventListener("click", () => {
            const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
            if (isOpen) {
                closeMenu();
            } else {
                openMenu();
            }
        });
    }

    if (menuClose) {
        menuClose.addEventListener("click", closeMenu);
    }

    if (overlay) {
        overlay.addEventListener("click", closeMenu);
    }

    function openDesktopMore() {
        if (!desktopMoreButton || !desktopMoreMenu) return;

        desktopMoreButton.setAttribute("aria-expanded", "true");
        desktopMoreMenu.classList.remove("invisible", "opacity-0");
    }

    function closeDesktopMore() {
        if (!desktopMoreButton || !desktopMoreMenu) return;

        desktopMoreButton.setAttribute("aria-expanded", "false");
        desktopMoreMenu.classList.add("invisible", "opacity-0");
    }

    if (desktopMoreButton && desktopMoreMenu) {
        desktopMoreButton.addEventListener("click", () => {
            const isOpen =
                desktopMoreButton.getAttribute("aria-expanded") === "true";
            if (isOpen) {
                closeDesktopMore();
            } else {
                openDesktopMore();
            }
        });

        document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Node)) return;

            if (
                !desktopMoreMenu.contains(target) &&
                !desktopMoreButton.contains(target)
            ) {
                closeDesktopMore();
            }
        });
    }
</script>
