---
import { getPocketBaseClient } from "../../backend/backend.mjs";

interface Props {
    record?: Record<string, unknown> | null;
    field?: string;
    alt?: string;
    classImg?: string;
    size?: string;
}

const {
    record = null,
    field = "photo",
    alt = "Image",
    classImg = "",
    size = "1600x400",
} = Astro.props as Props;

const pb = getPocketBaseClient();
const imageFieldValue = record?.[field];

function firstFileName(value: unknown): string {
    if (Array.isArray(value)) {
        return String(value[0] ?? "").trim();
    }

    if (typeof value !== "string") {
        return "";
    }

    const trimmedValue = value.trim();

    if (!trimmedValue) {
        return "";
    }

    if (trimmedValue.startsWith("[") && trimmedValue.endsWith("]")) {
        try {
            const parsedValue = JSON.parse(trimmedValue);
            if (Array.isArray(parsedValue)) {
                return String(parsedValue[0] ?? "").trim();
            }
        } catch {}
    }

    if (trimmedValue.includes(",")) {
        return trimmedValue.split(",")[0]?.trim() ?? "";
    }

    return trimmedValue;
}

const fileName = firstFileName(imageFieldValue);
const imageUrl =
    fileName && record
        ? pb.files.getURL(record, fileName, { thumb: size })
        : null;
---

{
    imageUrl && (
        <img
            class={classImg}
            src={imageUrl}
            alt={alt || "Image"}
            loading="lazy"
        />
    )
}
